<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

RewriteEngine On

#RewriteCond %{HTTP_HOST} !^www\. [NC]
#RewriteRule ^(.*)$ http://www.%{HTTP_HOST}/$1 [R=301,L]

# HTTP trafiğini HTTPS'ye yönlendir
#RewriteCond %{SERVER_PORT} 80
#RewriteCond %{HTTP_HOST} ^(www\.)?avsglobalsupply\.com [NC]
#RewriteRule ^(.*)$ https://www.avsglobalsupply.com/$1 [R=301,L]

# Eğer dizin veya dosya yoksa, .php'li versiyonunu dene
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/]+)/?$ $1.php [L]

# 1) "send.php" hariç, uzantısız URL'leri gerçek .php dosyalarına yönlendir
RewriteCond %{REQUEST_URI} !^/send\.php$ [NC]
RewriteCond %{REQUEST_URI} !^/TG\.php$ [NC]
RewriteCond %{REQUEST_URI} !^/Exception\.php$ [NC]
RewriteCond %{REQUEST_URI} !^/PHPMailer\.php$ [NC]
RewriteCond %{REQUEST_URI} !^/SMTP\.php$ [NC]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^\.]+)$ $1.php [L]

# 2) Eski .php uzantılı URL'leri, uzantısız URL'lere yönlendir (send.php hariç)
RewriteCond %{THE_REQUEST} \s/+(.*?/)?(?:index)?(.*?)\.php[\s?/] [NC]
RewriteCond %2 !^(send)$ [NC]
RewriteCond %2 !^(TG)$ [NC]
RewriteCond %2 !^(Exception)$ [NC]
RewriteCond %2 !^(PHPMailer)$ [NC]
RewriteCond %2 !^(SMTP)$ [NC]
RewriteRule ^ /%1%2 [R=301,L,NE]

ErrorDocument 404 error.php
ErrorDocument 500 error.php
# Eski sitedeki url'leri yeni url'lere yönlendir

# "pages/{slug}" şeklindeki istekleri "services.php?slug={slug}"'ye yönlendir
RewriteRule ^hizmetler/([^/]+)$ hizmetler.php?slug=$1 [L]
RewriteRule ^locations\.html$ /areas [R=301,L]
RewriteRule ^career\.html$ /career [R=301,L]
RewriteRule ^map\.html$ /areas [R=301,L]
RewriteRule ^management\.html$ /management [R=301,L]
RewriteRule ^logistic\.html$ /logistics [R=301,L]
RewriteRule ^seafarereducations\.html$ /education [R=301,L]
RewriteRule ^profile\.html$ /company [R=301,L]
RewriteRule ^offshore\.html$ /onoffshore [R=301,L]
RewriteRule ^global\.html$ /globalsupply [R=301,L]
RewriteRule ^media\.html$ /company [R=301,L]
RewriteRule ^trading\.html$ /food [R=301,L]
RewriteRule ^ship-supply-turkey\.html$ /ship-supply-turkey [R=301,L]
RewriteRule ^contact\.html$ /contact [R=301,L]
RewriteRule ^nordichamburg\.html$ /nordic [R=301,L]
RewriteRule ^provision\.html$ /provision [R=301,L]
RewriteRule ^partners\.html$ /partners [R=301,L]
RewriteRule ^nordic\.html$ /nordic [R=301,L]
RewriteRule ^kvkk\.html$ /kvkk [R=301,L]
RewriteRule ^technical\.html$ /technical [R=301,L]
RewriteRule ^avsgreece\.html$ https://avsgreece.gr/ [R=301,L]
RewriteRule ^kvkken\.html$ /kvkk [R=301,L]
RewriteRule ^newvendors\.html$ /newvendors [R=301,L]
RewriteRule ^vision\.html$ /company [R=301,L]
RewriteRule ^gallery\.html$ /company [R=301,L]
RewriteRule ^whyavs\.html$ /company [R=301,L]
RewriteRule ^people\.html$ /team [R=301,L]
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^education\.html$ /education [R=301,L]
RewriteRule ^food\.html$ /food [R=301,L]
RewriteRule ^tr/ikmal /tr/kumanya [R=301,L]
RewriteRule ^blog-detay/(.*)$ blog-detay.php?slug=$1 [L,QSA]
RewriteRule ^haber-detay/(.*)$ haber-detay.php?slug=$1 [L,QSA]

<IfModule mod_deflate.c>
  # Compress HTML, CSS, JavaScript, Text, XML and fonts
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
  AddOutputFilterByType DEFLATE application/x-font
  AddOutputFilterByType DEFLATE application/x-font-opentype
  AddOutputFilterByType DEFLATE application/x-font-otf
  AddOutputFilterByType DEFLATE application/x-font-truetype
  AddOutputFilterByType DEFLATE application/x-font-ttf
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE font/opentype
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE image/x-icon
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml

  # Remove browser bugs (only needed for really old browsers)
  BrowserMatch ^Mozilla/4 gzip-only-text/html
  BrowserMatch ^Mozilla/4\.0[678] no-gzip
  BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
  Header append Vary User-Agent
</IfModule>

# 480 weeks
<FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|js|css|swf)$">
Header set Cache-Control "max-age=290304000, public"
</FilesMatch>

# 2 DAYS
<FilesMatch "\.(xml|txt)$">
Header set Cache-Control "max-age=172800, public, must-revalidate"
</FilesMatch>

# 2 HOURS
<FilesMatch "\.(html|htm)$">
Header set Cache-Control "max-age=7200, must-revalidate"
</FilesMatch>

<ifModule mod_gzip.c>
  mod_gzip_on Yes
  mod_gzip_dechunk Yes
  mod_gzip_item_include file \.(html?|txt|css|js|php|pl)$
  mod_gzip_item_include handler ^cgi-script$
  mod_gzip_item_include mime ^text/.*
  mod_gzip_item_include mime ^application/x-javascript.*
  mod_gzip_item_exclude mime ^image/.*
  mod_gzip_item_exclude rspheader ^Content-Encoding:.*gzip.*
</ifModule>

<IfModule mod_headers.c>
	Header set Access-Control-Allow-Origin "*"
	Header set Access-Control-Allow-Credentials true
    #Header always set X-Frame-Options "DENY"
	#Header set X-Content-Type-Options "nosniff"
	#Header set Referrer-Policy "no-referrer-when-downgrade"
</IfModule>


    